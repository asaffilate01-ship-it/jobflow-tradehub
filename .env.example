# Browser-safe Supabase configuration only. Never put service-role or provider
# secrets in VITE_* variables because they are embedded in the web bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Configure server-only values with `supabase secrets set`; do not add them here:
# PUBLIC_APP_URL, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
# STRIPE_BASIC_PRICE_ID, STRIPE_PREMIUM_PRICE_ID
# SCHEDULED_SYNC_SECRET, INTEGRATION_OUTBOX_CRON_SECRET
# MERCHANT_CREDENTIALS_ENCRYPTION_KEY, BROWSERLESS_API_KEY
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
# RESEND_API_KEY, EMAIL_FROM, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
# DOKUVERA_API_URL, DOKUVERA_API_TOKEN, DOKUVERA_SIGNING_SECRET, DOKUVERA_WEBHOOK_SECRET
# REPAIR_VISION_GATEWAY_URL, REPAIR_VISION_GATEWAY_SECRET
# TRADE_SEARCH_AI_URL, TRADE_SEARCH_AI_SECRET
# GABLEY_WEBHOOK_URL, GABLEY_WEBHOOK_SECRET
# IMMOVIQ_WEBHOOK_URL, IMMOVIQ_WEBHOOK_SECRET
